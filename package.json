{
  "name": "live-psalms",
  "description": "Live Psalms - offline worship presentation and Bible study",
  "author": "Live Psalms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:deb": "tsc && vite build && electron-builder --linux deb",
    "release:all": "npm run build:win && npx electron-builder --linux deb && gh release upload v1.1.0 dist_electron/LivePsalms-Setup.exe dist_electron/LivePsalms-Windows-Portable.exe dist_electron/LivePsalms-Ubuntu-amd64.deb --clobber"
  },
  "build": {
    "appId": "com.livepsalms.app",
    "productName": "Live Psalms",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "sign": null,
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Live Psalms",
      "uninstallDisplayName": "Live Psalms",
      "artifactName": "LivePsalms-Setup.exe"
    },
    "portable": {
      "artifactName": "LivePsalms-Windows-Portable.exe"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "maintainer": "Live Psalms <support@livepsalms.app>",
      "icon": "build/icons",
      "category": "AudioVideo",
      "artifactName": "LivePsalms-Ubuntu-${arch}.deb"
    },
    "deb": {
      "afterInstall": "electron/linux-after-install.sh"
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
